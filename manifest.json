{
  "manifest_version": 3,
  "name": "语雀 Markdown 导出器",
  "version": "2.1.2",
  "description": "查看、复制和导出当前语雀文档、表格或数据表，支持 Markdown、CSV 和图片本地化。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "http://yuque.com/*",
    "http://*.yuque.com/*",
    "https://yuque.com/*",
    "https://*.yuque.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/table-capture.js",
        "lib/table-page.js",
        "lib/yuque-doc.js",
        "lib/sheet-parse.js"
      ],
      "matches": [
        "http://yuque.com/*",
        "http://*.yuque.com/*",
        "https://yuque.com/*",
        "https://*.yuque.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "语雀 Markdown 导出器",
    "default_popup": "popup/popup.html"
  }
}
